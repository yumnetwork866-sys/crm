// Prisma Schema for VietCRM (PostgreSQL)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String // Hashed with bcrypt
  avatar             String?
  role               String // 'Admin' | 'Sales Manager' | 'Sales Rep' | 'Marketing Lead' | 'Customer Support'
  phone              String?
  department         String   @default("Sales")
  status             String   @default("active") // 'active' | 'inactive'
  lastActive         DateTime @default(now())
  assignedLeadsCount Int      @default(0)
  totalRevenue       Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Customer {
  id                 String    @id @default(uuid())
  phone              String
  name               String
  gender             String    @default("Khác") // 'Nam' | 'Nữ' | 'Khác'
  address            String    @default("")
  email              String?
  note               String?
  source             String    @default("Direct") // 'Facebook' | 'TikTok' | 'Google' | 'Website' | 'Zalo' | 'Referral' | 'Direct'
  campaign           String    @default("N/A")
  adSet              String?
  landingPage        String?
  firstContact       DateTime  @default(now())
  lastContact        DateTime  @default(now())
  owner              String    @default("Chưa phân công")
  status             String    @default("New Lead") // 'New Lead' | 'Contacted' | 'Quoted' | 'Won' | 'Lost'
  group              String? // 'group_1' | 'group_2' | 'group_3' | 'group_4' — independent from status
  totalOrders        Int       @default(0)
  totalSpent         Float     @default(0)
  lastPurchaseDate   DateTime?
  interestedProducts String[]  @default([])
  whatsappOptIn      Boolean   @default(false)
  whatsappOptInDate  DateTime?

  notes            CustomerNote[]
  orders           Order[]
  automationLogs   AutomationLog[]
  whatsappMessages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([owner])
  @@index([source])
  @@index([whatsappOptIn])
  @@index([updatedAt(sort: Desc)])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_phone_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_email_trgm_idx")
  @@index([campaign(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_campaign_trgm_idx")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  author     String
  content    String
  createdAt  DateTime @default(now())
  type       String   @default("note") // 'note' | 'call' | 'whatsapp' | 'email' | 'system'

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt(sort: Desc)])
}

model Product {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  category    String // 'Mỹ Phẩm' | 'Thực Phẩm Chức Năng' | 'Thời Trang' | 'Gia Dụng' | 'Khác'
  price       Float
  costPrice   Float
  stock       Int     @default(0)
  status      String  @default("In Stock") // 'In Stock' | 'Low Stock' | 'Out of Stock'
  sku         String?
  description String?
  image       String?

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model Order {
  id            String   @id @default(uuid())
  orderCode     String   @unique
  customerId    String?
  customerName  String?
  customerPhone String?
  date          DateTime @default(now())
  totalAmount   Float    @default(0)
  status        String   @default("Processing") // 'Completed' | 'Processing' | 'Cancelled'
  notes         String?

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  products OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([date(sort: Desc)])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int     @default(1)
  price       Float

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model BroadcastCampaign {
  id               String   @id @default(uuid())
  name             String
  targetGroup      String
  targetProduct    String?
  targetGender     String?
  targetCountry    String?
  category         String   @default("Thông báo")
  templateName     String?
  templateLanguage String   @default("vi")
  messageTemplate  String
  status           String   @default("Draft") // Draft | Pending | Sending | Completed | PartiallyFailed | Failed | Cancelled
  totalTargeted    Int      @default(0)
  optedInCount     Int      @default(0)
  sentCount        Int      @default(0)
  deliveredCount   Int      @default(0)
  readCount        Int      @default(0)
  respondedCount   Int      @default(0)
  failedCount      Int      @default(0)
  launchedById     String?
  launchedAt       DateTime?
  completedAt      DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipients BroadcastRecipient[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model BroadcastRecipient {
  id               String    @id @default(uuid())
  campaignId       String
  customerId       String?
  customerName     String
  customerPhone    String
  normalizedPhone  String
  templateParams   Json?
  status           String    @default("Pending") // Pending | Processing | Retry | Sent | Delivered | Read | Failed | Cancelled
  metaMessageId    String?   @unique
  attemptCount     Int       @default(0)
  nextAttemptAt    DateTime?
  lockedAt         DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  respondedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, normalizedPhone])
  @@index([campaignId, status])
  @@index([status, nextAttemptAt])
}

model AutomationLog {
  id         String   @id @default(uuid())
  customerId String
  step       Int
  stepName   String
  sentAt     DateTime @default(now())
  message    String
  status     String   @default("Sent") // 'Sent' | 'Delivered' | 'Read' | 'Failed'

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, sentAt(sort: Desc)])
}

model IntegrationSetting {
  id                    String    @id @default("default")
  whatsappPhoneNumberId String?
  whatsappWabaId        String?
  whatsappAccessToken   String?
  whatsappVerifyToken   String?   @default("YUMNETWORK_CRM_META_VERIFY_TOKEN_2026")
  whatsappAppId         String?
  whatsappAppSecret     String?
  status                String    @default("disconnected") // 'connected' | 'disconnected' | 'error'
  lastConnectedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model WhatsAppMessage {
  id            String    @id @default(uuid())
  customerId    String?
  customerName  String
  customerPhone String
  sender        String // 'customer' | 'agent'
  agentName     String?
  channel       String    @default("WhatsApp")
  content       String
  isRead        Boolean   @default(false)
  readBy        String?
  readAt        DateTime?
  isRealSent    Boolean   @default(true)
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([customerPhone])
  @@index([timestamp(sort: Desc)])
  @@index([isRead, sender])
}
