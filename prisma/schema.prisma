// Prisma Schema for VietCRM (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String   // Hashed with bcrypt
  avatar             String?
  role               String   // 'Admin' | 'Sales Manager' | 'Sales Rep' | 'Marketing Lead' | 'Customer Support'
  phone              String?
  department         String   @default("Sales")
  status             String   @default("active") // 'active' | 'inactive'
  lastActive         DateTime @default(now())
  assignedLeadsCount Int      @default(0)
  totalRevenue       Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Customer {
  id                 String         @id @default(uuid())
  phone              String
  name               String
  gender             String         @default("Khác") // 'Nam' | 'Nữ' | 'Khác'
  address            String         @default("")
  email              String?
  note               String?
  source             String         @default("Direct") // 'Facebook' | 'TikTok' | 'Google' | 'Website' | 'Zalo' | 'Referral' | 'Direct'
  campaign           String         @default("N/A")
  adSet              String?
  landingPage        String?
  firstContact       DateTime       @default(now())
  lastContact        DateTime       @default(now())
  owner              String         @default("Chưa phân công")
  status             String         @default("New Lead") // 'New Lead' | 'Contacted' | 'Quoted' | 'Won' | 'Lost'
  totalOrders        Int            @default(0)
  totalSpent         Float          @default(0)
  lastPurchaseDate   DateTime?
  interestedProducts String[]       @default([])
  whatsappOptIn      Boolean        @default(false)
  whatsappOptInDate  DateTime?
  
  notes              CustomerNote[]
  orders             Order[]
  automationLogs     AutomationLog[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  author     String
  content    String
  createdAt  DateTime @default(now())
  type       String   @default("note") // 'note' | 'call' | 'whatsapp' | 'email' | 'system'

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Product {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  category    String      // 'Mỹ Phẩm' | 'Thực Phẩm Chức Năng' | 'Thời Trang' | 'Gia Dụng' | 'Khác'
  price       Float
  costPrice   Float
  stock       Int         @default(0)
  status      String      @default("In Stock") // 'In Stock' | 'Low Stock' | 'Out of Stock'
  sku         String?
  description String?
  image       String?
  
  orderItems  OrderItem[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  orderCode     String      @unique
  customerId    String?
  customerName  String?
  customerPhone String?
  date          DateTime    @default(now())
  totalAmount   Float       @default(0)
  status        String      @default("Processing") // 'Completed' | 'Processing' | 'Cancelled'
  notes         String?

  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  products      OrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int      @default(1)
  price       Float

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model BroadcastCampaign {
  id              String   @id @default(uuid())
  name            String
  targetGroup     String
  targetProduct   String?
  targetCountry   String?
  category        String   @default("Thông báo") // 'Khuyến mại' | 'Flash Sale' | 'Voucher' | 'Sản phẩm mới' | 'Thông báo'
  messageTemplate String
  status          String   @default("Draft") // 'Draft' | 'Sending' | 'Completed'
  totalTargeted   Int      @default(0)
  optedInCount    Int      @default(0)
  sentCount       Int      @default(0)
  deliveredCount  Int      @default(0)
  readCount       Int      @default(0)
  respondedCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AutomationLog {
  id          String   @id @default(uuid())
  customerId  String
  step        Int
  stepName    String
  sentAt      DateTime @default(now())
  message     String
  status      String   @default("Sent") // 'Sent' | 'Delivered' | 'Read' | 'Failed'

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}
