DATABASE_URL="postgresql://user:password@localhost:5432/crm?schema=public"
APP_URL="https://crm.yumnetwork.vn"
JWT_SECRET="vietcrm_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Backend Server Port
PORT=5002
NODE_ENV=production

# ==========================================
# CẤU HÌNH META / WHATSAPP CLOUD API (WABA)
# ==========================================
# 1. WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_PHONE_NUMBER_ID=""

# 2. Permanent Access Token từ Meta (System User Token)
META_ACCESS_TOKEN="your_meta_system_user_access_token"
# Tùy chọn thay thế / alias:
# WHATSAPP_ACCESS_TOKEN=""

# 3. Webhook & App Credentials
META_APP_ID="your_meta_app_id"
# WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET="your_whatsapp_app_secret"
# META_APP_SECRET=""

META_EMBEDDED_SIGNUP_CONFIG_ID="your_embedded_signup_config_id" #never expire:your_config_id
META_GRAPH_VERSION="v26.0"
META_VERIFY_TOKEN="your_meta_verify_token"

META_TOKEN_ENCRYPTION_KEY="your_32_byte_hex_encryption_key"

# 4. Meta Product Catalog (Tùy chọn)
META_BUSINESS_ID=""
META_CATALOG_ID=""

# ==========================================
# LOGIN (ADMIN MẶC ĐỊNH)
# ==========================================
ADMIN="admin"
ADMIN_PASSWORD="your_admin_password"

# ==========================================
# Legacy Dify: native CRM suggestions/auto-replies use Ollama and /ai settings
# ==========================================
DIFY_AI_ENABLED=true
DIFY_API_URL="https://dify.yumnetwork.vn/v1"
DIFY_API_KEY="app-your_dify_api_key"
DIFY_TIMEOUT_MS=20000
DIFY_AGENT_NAME="Yum Assistant"
DIFY_DEFAULT_BRAND_NAME="Yum Network"

# ==========================================
# OLLAMA LOCAL TRANSLATION
# ==========================================
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_TRANSLATION_MODEL="translategemma:12b"
OLLAMA_TRANSLATION_TIMEOUT_MS=90000
# Dịch nền tin nhắn mới của khách, lần lượt từng tin.
AUTO_TRANSLATE_INCOMING=true

# Native CRM AI: model must already be installed in the Ollama server above.
# Other settings and the knowledge base are managed on /ai.
AI_CHAT_MODEL="gemma4:latest"

# ==========================================
# CẤU HÌNH FRONTEND (VITE)
# ==========================================
VITE_META_BUSINESS_ID=""
VITE_WHATSAPP_WABA_ID=""

# ==========================================
# CẤU HÌNH BROADCAST CAMPAIGN & BACKGROUND WORKER (TÙY CHỌN)
# ==========================================
# CAMPAIGN_WORKER_INTERVAL_MS=2000
# CAMPAIGN_WORKER_CONCURRENCY=5
# CAMPAIGN_MAX_ATTEMPTS=3
# MAX_CAMPAIGN_RECIPIENTS=5000
# DEFAULT_PHONE_COUNTRY_CODE=60

# ==========================================
# CẤU HÌNH DEV SERVER / HMR (TÙY CHỌN)
# ==========================================
# HMR_CLIENT_PORT=
# DISABLE_HMR=false

# Logging: info includes API GETs; debug adds healthchecks/static GETs, SSE and job details.
LOG_LEVEL=info
# Auto: pretty in development, JSON in production. Override with pretty or json.
# LOG_FORMAT=json
# NO_COLOR=1

# PM2 production backend serves API/uploads only; omit or set true for combined dev.
# SERVE_FRONTEND=false

# Standalone frontend dev (backend remains production).
# FRONTEND_DEV_HOST=crm.yumnetwork.vn
# FRONTEND_DEV_PORT=5174
# FRONTEND_API_TARGET=http://127.0.0.1:5002

# RAG embeddings (model installed separately on the Ollama server)
AI_EMBEDDING_MODEL="embeddinggemma:300m"
AI_EMBEDDING_MIN_SCORE=0.55
