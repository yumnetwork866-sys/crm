# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/vietcrm?schema=public"

# Backend Server Port
PORT=5002

# Application Base URL
APP_URL="https://crm.yumnetwork.vn"

# JWT Secret
JWT_SECRET="vietcrm_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Gemini AI API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ==========================================
# CẤU HÌNH META / WHATSAPP CLOUD API (WABA)
# ==========================================
# 1. WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID="120038891167727"

# 2. Phone Number ID của số WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=""

# 3. Permanent Access Token từ Meta (System User Token)
WHATSAPP_ACCESS_TOKEN=""

# 4. Webhook Verify Token (Dùng để xác minh Webhook trên Meta for Developers)
META_VERIFY_TOKEN="YUMNETWORK_CRM_META_VERIFY_TOKEN_2026"

# 5. Meta App ID & App Secret (Tùy chọn)
WHATSAPP_APP_ID=""
# Required to validate Meta's X-Hub-Signature-256 webhook header.
WHATSAPP_APP_SECRET=""
