# ==========================================
# CẤU HÌNH CƠ BẢN SERVER & DATABASE
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/vietcrm?schema=public"
APP_URL="https://crm.example.com"
PORT=5002
NODE_ENV=production

# ==========================================
# XÁC THỰC & BẢO MẬT (AUTH)
# ==========================================
JWT_SECRET="replace_with_a_secure_random_secret_key"
JWT_EXPIRES_IN="7d"

# Tài khoản Admin mặc định khi khởi tạo
ADMIN="admin"
ADMIN_PASSWORD="your_admin_password"

# Khóa mã hóa token Meta lưu trữ trong database (32-byte hex string)
META_TOKEN_ENCRYPTION_KEY="replace_with_32_byte_hex_key"

# ==========================================
# CẤU HÌNH META / WHATSAPP CLOUD API (WABA)
# ==========================================
WHATSAPP_BUSINESS_ACCOUNT_ID="your_waba_id"
META_ACCESS_TOKEN="your_meta_system_user_access_token"
META_APP_ID="your_meta_app_id"
WHATSAPP_APP_SECRET="your_meta_app_secret"
META_EMBEDDED_SIGNUP_CONFIG_ID="your_embedded_signup_config_id"
META_GRAPH_VERSION="v26.0"
META_VERIFY_TOKEN="your_webhook_verify_token"

# Cấu hình Catalog Meta (Tùy chọn)
META_BUSINESS_ID=""
META_CATALOG_ID=""

# ==========================================
# CẤU HÌNH DIFY AI BOT (AUTO-REPLY / CSKH)
# ==========================================
DIFY_AI_ENABLED=true
DIFY_API_URL="https://dify.example.com/v1"
DIFY_API_KEY="app-your_dify_api_key"
DIFY_TIMEOUT_MS=20000
DIFY_AGENT_NAME="Yum Assistant"
DIFY_DEFAULT_BRAND_NAME="Yum Network"

# ==========================================
# CẤU HÌNH FRONTEND (VITE)
# ==========================================
VITE_META_BUSINESS_ID=""
VITE_WHATSAPP_WABA_ID=""

# ==========================================
# CẤU HÌNH CAMPAIGN & BACKGROUND WORKER (TÙY CHỌN)
# ==========================================
# CAMPAIGN_WORKER_INTERVAL_MS=2000
# CAMPAIGN_WORKER_CONCURRENCY=5
# CAMPAIGN_MAX_ATTEMPTS=3
# MAX_CAMPAIGN_RECIPIENTS=5000
# DEFAULT_PHONE_COUNTRY_CODE=60
